# InstantDB Configuration
# Copy this to .env and fill in your actual app ID and admin token

# ============================================================================
# REQUIRED CONFIGURATION
# ============================================================================

# Your InstantDB app ID (used by both Vite client and backend scripts)
VITE_INSTANTDB_APP_ID=your-app-id-here

# Admin token for database operations (get from InstantDB dashboard)
# KEEP THIS SECRET! Never commit to git!
INSTANT_ADMIN_TOKEN=your-admin-token-here

# ============================================================================
# YAHOO OAUTH (Phase 2 — auth broker, see WEEKLY_QUIZ_PLAN.md)
# ============================================================================
# Only used server-side by netlify/functions/auth-yahoo-*.ts — do NOT prefix
# with VITE_, these must never reach the client bundle.

# From the Yahoo Developer app (Confidential Client)
YAHOO_CLIENT_ID=your-yahoo-client-id-here
YAHOO_CLIENT_SECRET=your-yahoo-client-secret-here

# Must exactly match a redirect URI registered on the Yahoo app, e.g.
# https://nfl.weekendwanderings.com/.netlify/functions/auth-yahoo-callback
# (use http://localhost:8888/.netlify/functions/auth-yahoo-callback for `netlify dev`)
YAHOO_REDIRECT_URI=http://localhost:8888/.netlify/functions/auth-yahoo-callback

# Origin the callback redirects back to after sign-in (no trailing slash)
APP_BASE_URL=http://localhost:8888

# ============================================================================
# USAGE
# ============================================================================
# yarn run dev                → Uses VITE_INSTANTDB_APP_ID
# yarn run build              → Uses VITE_INSTANTDB_APP_ID
# tsx scripts/push-schema.ts → Uses VITE_INSTANTDB_APP_ID + INSTANT_ADMIN_TOKEN
#
# CI/CD (GitHub Actions):
# Set these as GitHub Secrets:
# - VITE_INSTANTDB_APP_ID
# - INSTANT_ADMIN_TOKEN
#
# Netlify:
# Set environment variables per deploy context (production, branch-deploy, etc.)
